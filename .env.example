# wildprint environment configuration
# Copy this file to .env and fill in values.

# Required for the "openai" provider:
OPENAI_API_KEY=

# Required for the "recraft" provider (https://www.recraft.ai/docs):
RECRAFT_API_KEY=

# Default provider to use: "mock" (no API needed) or "openai"
DEFAULT_PROVIDER=mock

# Default model passed to providers that support it
DEFAULT_MODEL=gpt-image-1

# Default image size (WxH). The OpenAI images API accepts sizes like 1024x1024, 1536x1024, 1024x1536
DEFAULT_IMAGE_SIZE=1536x1024

# How many variations per (species, style) combo by default
DEFAULT_NUM_VARIATIONS=3

# Optional deterministic seed. Only the mock provider honors this fully; OpenAI image models do not support seeds.
DEFAULT_SEED=

# Normalized canvas dimensions
CANVAS_WIDTH=2048
CANVAS_HEIGHT=1365

# Flask review app secret key (dev only — replace in any shared environment)
FLASK_SECRET_KEY=dev-only-change-me
